# ============================================================
# FLASHY - Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to source control.
# ============================================================

# ---- Supabase (Required) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FLASHY
NODE_ENV=development

# ---- Cron / Scheduled Jobs ----
# A strong random secret used to authorize cron endpoint calls
CRON_SECRET=your-very-strong-random-secret-here

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- Facebook OAuth ----
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ---- SMS Provider (e.g. Twilio, Vonage) ----
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ---- Map Provider ----
# Set to "goong" or "google"
NEXT_PUBLIC_MAP_PROVIDER=goong
NEXT_PUBLIC_GOONG_API_KEY=your-goong-api-key
GOONG_API_KEY=your-goong-server-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ---- Payment Providers ----
# MoMo
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_WEBHOOK_SECRET=your-momo-webhook-secret

# ZaloPay
ZALOPAY_APP_ID=your-zalopay-app-id
ZALOPAY_KEY1=your-zalopay-key1
ZALOPAY_KEY2=your-zalopay-key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn
ZALOPAY_WEBHOOK_SECRET=your-zalopay-webhook-secret

# ShopeePay / AirPay
SHOPEE_PAY_PARTNER_ID=your-shopee-pay-partner-id
SHOPEE_PAY_SECRET_KEY=your-shopee-pay-secret-key

# ---- KYC Provider ----
KYC_PROVIDER=manual
KYC_API_KEY=your-kyc-provider-api-key
KYC_API_URL=https://api.kyc-provider.com

# ---- Telephone Relay / Virtual Number ----
PHONE_RELAY_PROVIDER=disabled
PHONE_RELAY_API_KEY=your-phone-relay-api-key

# ---- File Storage ----
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1

# ---- Error Monitoring (Sentry) ----
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
